<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      صلاحية الإنترنت لغرضٍ واحدٍ محدَّد: فحص وجود إصدار أحدث من التطبيق.

      ما يُرسَل: طلب GET واحد بلا أي بيانات — لا معرّف جهاز، ولا إحصاءات،
      ولا شيء ممّا في قاعدة البيانات. والعنوان مكتوبٌ ثابتًا في
      MainActivity.UPDATE_URL ولا يأتي من الواجهة، والمضيف يُتحقَّق منه بعد
      أي تحويل. وواجهةُ WebView نفسها محبوسة في assets عبر WebViewClient
      يرفض كل ما ليس file:// — فلا شيء فيها يستطيع الاتصال.

      بيانات المرضى لا تغادر الجهاز في أي حال.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dalili"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- مزوّد ملفات لمشاركة الصورة الناتجة (وصفة/تحاليل) عبر واتساب أو أي تطبيق آخر -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="me.alaoufi.dalili.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
